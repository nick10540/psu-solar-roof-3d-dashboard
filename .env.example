# Copy to `.env` next to docker-compose.yml. Everything marked REQUIRED is
# enforced by compose itself - `docker compose up` fails fast rather than
# starting a half-configured stack.

# ---------------------------------------------------------------------------
# REQUIRED - HTTP Basic auth
#
# nginx applies these to the whole origin: the dashboard, its assets and the
# /api/solaredge proxy. This is what keeps the board off the open venue
# network, so the container refuses to start when they are missing rather than
# quietly serving to everyone.
#
# Generate a password with `openssl rand -base64 18`.
# ---------------------------------------------------------------------------
BASIC_AUTH_USER="psu"
BASIC_AUTH_PASSWORD="change_me"

# Optional. Shown in the browser's password prompt.
# BASIC_AUTH_REALM="PSU Solar Roof Dashboard"

# Optional. Comma-separated CIDRs that skip the prompt entirely - intended for
# the kiosk PC, so the 72" TV comes back up unattended after a power cut.
# Everyone else still needs the password. Empty means no exemptions.
# BASIC_AUTH_ALLOW_IPS="10.0.0.42/32,192.168.1.0/24"

# Optional. Pre-hashed htpasswd line(s); wins over USER/PASSWORD above. The way
# to use bcrypt or to have more than one account:
#   htpasswd -nB kiosk
# BASIC_AUTH_HTPASSWD="kiosk:$2y$05$..."

# ---------------------------------------------------------------------------
# REQUIRED - SolarEdge backend
#
# The Fleet API Key, generated under "My Fleet Access" in the SolarEdge
# Developer Platform. Lives only in the backend container; the browser never
# sees it. For local `npm run worker` it goes in worker/.dev.vars instead.
# ---------------------------------------------------------------------------
SOLAREDGE_API_KEY="your_fleet_api_key"

# Optional. Overrides the site IDs the backend reads. Default covers all five
# registrations - see the Sites table in README.md.
# SOLAREDGE_SITE_IDS="4956359,4956575,4956547,4821237,4947126"

# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
