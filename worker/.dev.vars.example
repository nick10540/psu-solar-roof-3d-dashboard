# Copy to worker/.dev.vars and fill in. NEVER commit the real value, and never
# place this file under public/ — Vite copies public/ verbatim into dist/.

# Fleet API Key from the SolarEdge Developer Platform ("My Fleet Access").
# One key covers every site in the account's fleet, sent as X-API-Key.
SOLAREDGE_API_KEY=

# Site IDs the backend is allowed to read.
#   4956359 + 4956575 + 4956547 = หาดใหญ่ (three registrations, summed on one pin)
#   4821237 = ตรัง | 4947126 = ปัตตานี | 4817295 = สุราษฎร์ธานี
SOLAREDGE_SITE_IDS=4956359,4956575,4956547,4821237,4947126,4817295

SOLAREDGE_API_BASE=https://monitoringapi.solaredge.com/v2

# Spend ceilings this backend holds itself to.
#
# PER MINUTE: 50, matching the upgraded package (was 10 on the entry one). The
# backend WAITS rather than bursting past it, so setting this above what the
# account really allows does not buy throughput — it just moves the refusal
# upstream, where it arrives as a 429 on whichever site happens to be last in
# the list. At 50 even the 10-second floor still fits, but not by much: the six
# registrations above want 36/min for the live reading plus ~1.6/min for the
# fixed series group.
SOLAREDGE_MAX_CALLS_PER_MIN=50

# PER MONTH: 100000 so the configurable intervals have room to run. A guard
# against silent overspend, NOT a claim about the plan — if the account's real
# allowance is lower, SolarEdge starts refusing long before this fires. Set it
# to the real allowance to have the guard (which serves cache instead of
# failing) come first.
#
# With the per-minute ceiling at 50 this was the tighter limit by far, until the
# default cadence went to an hour. Now the six IDs listed above spend ~726
# calls/day, ~22k in a 30-day month; add the seventh registration SITE_REGISTRY
# already knows (4966328) and it is ~847/day, ~25k. (At a 900 s default those
# seven came to ~101k, level with this guard; at the original 300 s, ~141k, so a
# week of every month was served from cache. At the 10 s floor it is ~63k/day —
# a day and a half.) The settings panel does that arithmetic live — calls/min,
# /day and /month for the sites actually on screen — so check it there after
# changing the interval.
SOLAREDGE_MONTHLY_CALL_BUDGET=100000

# Default cadence, in seconds, for a request that carries none of its own
# (a curl check, or a kiosk whose localStorage was wiped). The dashboard sends
# its own per-site value and it wins. Floor is 10 either way.
#
# This is the ONLY cadence there is. It governs /power-flow, the instantaneous
# PV reading, which SolarEdge itself refreshes every 3 seconds — so turning it
# down really does put a newer number on the board. One call per site per tick.
#
# Everything else (/power, today's /energy, /energy?MONTH,
# /environmental-benefits) is QUARTER_HOUR data — the API refuses anything
# finer — and runs on a fixed 900 s that is not configurable. The old
# SOLAREDGE_ENERGY_INTERVAL_SEC governed those and is now ignored;
# SOLAREDGE_POWER_INTERVAL_SEC is still read as a fallback for the name below.
#
# Past that fixed cadence this number governs the whole board, not just the live
# kW: nothing is fetched without a request, so a dashboard asking once an hour
# gets the quarter-hour series once an hour too. At 3600 that is five upstream
# calls per site per hour and everything on screen — kW, energy, CO2, chart —
# up to an hour old. Turn it down for a livelier board and watch the monthly
# total above; at or under 900 the series go back to their own quarter hour.
SOLAREDGE_POWER_FLOW_INTERVAL_SEC=3600

# CORS allow-list. Leave empty for same-origin (behind the Vite/Nginx proxy).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

PORT=8787
